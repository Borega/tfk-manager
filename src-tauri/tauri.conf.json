{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tfk-manager",
  "version": "0.0.25",
  "identifier": "com.soesc.tauri-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && node scripts/copy-backend.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TFK Manager",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "resources/backend"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Borega/tfk-manager/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5RDhDQUIwRkRCNTk5QzYKUldUR21iWDlzTXJZbVk3aCtUZ3NGa3dBLzhzcStrRjdOblZDOWJkY2tSbFpuSVVYNGJkR1hHcVgK",
      "dialog": false
    }
  }
}